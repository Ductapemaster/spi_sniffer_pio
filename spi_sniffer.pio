; =============================================================================
; SPI Bus Sniffer PIO Assembly Script (spi_sniffer.pio)
; Passive, multi-SM SPI bus sniffer for RP2040 / RP2350 microcontrollers.
; =============================================================================

.define PUBLIC IRQ_EVENT    7    ; Internal state machine synchronization interrupt

.define PUBLIC EV_DATA      0x00 ; Signal state for valid data sampling phase
.define PUBLIC EV_START     0x01 ; Signal state for frame start sequence (CS Fall)
.define PUBLIC EV_STOP      0x03 ; Signal state for frame stop sequence (CS Rise)

; --- CHIP SELECT START/STOP DETECTOR STATE MACHINE ---
.program spi_start
.wrap_target
wait_cs_low:
    wait 0 pin 0            ; Block until Chip Select falls to LOW
    set pins EV_START       ; Signal EV0=1, EV1=0 on virtual event pins
    irq wait IRQ_EVENT      ; Fire event interrupt and stall until spi_main acknowledges
    wait 1 pin 0            ; Block execution until Chip Select rises to HIGH
    set pins EV_STOP        ; Signal EV0=1, EV1=1 on virtual event pins
    irq wait IRQ_EVENT      ; Fire event interrupt and stall until spi_main acknowledges
.wrap

; --- SPI CLOCK DATA SAMPLER STATE MACHINE ---
.program spi_data
.wrap_target
    wait 1 pin 0            ; Block until Clock rises to HIGH (Sampling Edge)
    jmp pin wait_clk_fall   ; If CS JMP pin is HIGH (Inactive), skip sampling and IRQ
    irq wait IRQ_EVENT      ; Fire event interrupt and stall until spi_main acknowledges
wait_clk_fall:    
    wait 0 pin 0            ; Block until Clock falls back to LOW
.wrap

; --- MAIN UNIFIED RECEIVE STATE MACHINE ---
.program spi_main
.wrap_target

wait_irq_event:
    wait 1 irq IRQ_EVENT    ; 1. Wait for synchronization event from spi_start or spi_data
    jmp pin handle_cs       ; 2. If JMP pin (EV0) is '1', it is a CS transition (START/STOP)
                            ;    Otherwise (EV0=0), it is a valid SPI Clock sample.
    in pins, 2              ; 3. Shift in 2 bits (MOSI & MISO) relative to IN base pin
    jmp wait_irq_event      ; 4. Loop back to wait for the next event

handle_cs:
    ; --- EXECUTES FOR ALL VALID CHIP SELECT BOUNDARY TRANSITIONS ---
    mov isr, pins           ; Snapshot current pin states starting from IN base
    in NULL, 16             ; Pad with 16 NULL bits to instantly trigger hardware autopush
    set pins EV_DATA        ; Reset virtual event pins back to EV_DATA (EV0=0, EV1=0)
.wrap

% c-sdk {

/**
 * @brief Initializes the SPI Start/Stop state machine (spi_start).
 */
void spi_start_program_init(PIO pio, uint sm, uint offset, float div, uint cs_pin, uint ev0_pin) {
    pio_sm_config c = spi_start_program_get_default_config(offset);
    
    // Configure virtual event pins as outputs (EV0, EV1)
    pio_gpio_init(pio, ev0_pin);
    pio_gpio_init(pio, ev0_pin + 1);
    sm_config_set_set_pins(&c, ev0_pin, 2);
    pio_sm_set_consecutive_pindirs(pio, sm, ev0_pin, 2, true);
    
    // Configure Chip Select as input
    gpio_init(cs_pin);
    gpio_set_dir(cs_pin, GPIO_IN);
    gpio_disable_pulls(cs_pin);
    sm_config_set_in_pins(&c, cs_pin); 
    
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
}

/**
 * @brief Initializes the SPI Clock sampler state machine (spi_data).
 */
void spi_data_program_init(PIO pio, uint sm, uint offset, float div, uint clk_pin, uint cs_pin) {
    pio_sm_config c = spi_data_program_get_default_config(offset);
    
    // Configure Clock Pin as input base
    gpio_init(clk_pin);
    gpio_set_dir(clk_pin, GPIO_IN);
    gpio_disable_pulls(clk_pin);
    sm_config_set_in_pins(&c, clk_pin);
    
    // Route CS pin as conditional hardware JMP target
    gpio_init(cs_pin);
    gpio_set_dir(cs_pin, GPIO_IN);
    gpio_disable_pulls(cs_pin);
    sm_config_set_jmp_pin(&c, cs_pin);
    
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
}

/**
 * @brief Initializes the main unified SPI sniffer state machine (spi_main).
 */
void spi_main_program_init(PIO pio, uint sm, uint offset, float div, uint mosi_pin, uint ev0_pin) {
    pio_sm_config c = spi_main_program_get_default_config(offset);
    
    // Initialize input lines (MOSI and MISO)
    gpio_init(mosi_pin);
    gpio_set_dir(mosi_pin, GPIO_IN);
    gpio_disable_pulls(mosi_pin);
    
    gpio_init(mosi_pin + 1); 
    gpio_set_dir(mosi_pin + 1, GPIO_IN);
    gpio_disable_pulls(mosi_pin + 1);

    // Map 4 consecutive input channels (MOSI, MISO, EV0, EV1)
    sm_config_set_in_pins(&c, mosi_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, mosi_pin, 4, false);
    
    // Map EV0 pin as conditional hardware JMP target
    sm_config_set_jmp_pin(&c, ev0_pin);
    
    // Map virtual event pins as SET output pins
    sm_config_set_set_pins(&c, ev0_pin, 2);
    pio_sm_set_consecutive_pindirs(pio, sm, ev0_pin, 2, true);
    
    // Configure FIFO shifting: Shift Left, Autopush enabled at 16 bits
    sm_config_set_in_shift(&c, false, true, 16);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
}

%}
